        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filter": {
          "type": "string"
        },
        "offset": {
          "type": "number"
        },
        "limit": {
          "description": "Max records per request (server max: 1000). Use with offset to paginate.",
          "type": "number"
        },
        "order": {
          "type": "string"
        },
        "continue": {
          "type": "boolean"
        },
        "related": {
          "description": "Include related records via FK (e.g. \"parent_table_by_fk_field\"). Check relationships in the data model.",
          "type": "string"
        },
        "count_only": {
          "description": "Return only the record count, no data. Use this instead of COUNT() in fields.",
          "type": "boolean"
        },
        "include_count": {
          "description": "Include total record count in response metadata alongside data.",
          "type": "boolean"
        },
        "include_schema": {
          "type": "boolean"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      },
      "required": [
        "table_name"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
