              }
            },
            "required": [
              "function",
              "field"
            ]
          },
          "description": "List of aggregations to compute"
        },
        "filter": {
          "description": "Filter rows before aggregating (same syntax as get_table_data)",
          "type": "string"
        },
        "group_by": {
          "description": "Group results by these columns",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "table_name",
        "aggregates"
      ],
